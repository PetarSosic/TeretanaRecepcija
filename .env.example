# Copy to .env.local. Never commit credentials. D-56: hosted Supabase, no Docker.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted Postgres connection URI, preferably the session pooler on port 5432.
# Used only by the transactional pgTAP test runner; never NEXT_PUBLIC_.
DATABASE_URL=

# Required for future milestones; leave empty until the integration is configured.
RESEND_API_KEY=
# Leave EMAIL_FROM empty in development to skip email (BR-161).
EMAIL_FROM=
BACKUP_ZIP_PASSWORD=
CRON_SECRET=
APP_URL=http://localhost:3000
STAFF_EMAIL_DOMAIN=staff.kpfitness.internal
SEED_OWNER_PASSWORD=

# Admin account (D-58): the only staff login that uses a real email, so a forgotten
# admin password can be reset. Used by npm run seed:admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
